<Window x:Class="HydroVue5_monitoring.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HydroVue5_monitoring"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Button Content="Connect" HorizontalAlignment="Left" Height="50" Margin="69,57,0,0" VerticalAlignment="Top" Width="97" FontSize="18" Click="btnConnect_Click"/>
        <Button Content="Disconnect" HorizontalAlignment="Left" Height="50" Margin="250,57,0,0" VerticalAlignment="Top" Width="97" FontSize="18" Click="btnDisconnect_Click"/>
        <Button Content="Send &quot;0M!&quot;" HorizontalAlignment="Left" Height="46" Margin="44,259,0,0" VerticalAlignment="Top" Width="133" FontSize="18" Click="btnSend_Click"/>
        <TextBox HorizontalAlignment="Left" Height="326" Margin="503,66,0,0" TextWrapping="Wrap" Text="TextBox" VerticalAlignment="Top" Width="195" IsReadOnly="True" Background="#FFFDE6FD" x:Name="txtLog"/>
        <Button Content="Send &quot;0D0!&quot;" HorizontalAlignment="Left" Height="46" Margin="214,259,0,0" VerticalAlignment="Top" Width="133" FontSize="18" Click="btnSend0D0_Click"/>

    </Grid>
</Window>
